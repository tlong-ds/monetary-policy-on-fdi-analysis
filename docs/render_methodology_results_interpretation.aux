\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces FDI net inflows (\% of GDP) by country, 2000--2023. Country-level time series reveal substantial heterogeneity in levels and trends across ASEAN-oriented economies. Singapore's structurally high FDI-to-GDP ratio reflects its role as a regional financial hub.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:fdi-country-trends}{{1.1}{4}{FDI net inflows (\% of GDP) by country, 2000--2023. Country-level time series reveal substantial heterogeneity in levels and trends across ASEAN-oriented economies. Singapore's structurally high FDI-to-GDP ratio reflects its role as a regional financial hub}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Yearly cross-country average of broad money growth and FDI net inflows. Both series show a co-movement pattern consistent with a liquidity channel, particularly during the post-GFC period (2010--2015).}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:trends}{{1.2}{5}{Yearly cross-country average of broad money growth and FDI net inflows. Both series show a co-movement pattern consistent with a liquidity channel, particularly during the post-GFC period (2010--2015)}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Distribution of key variables in the analytical panel. The monetary proxies (broad money, interest rates) and macro controls exhibit right-skewness and substantial dispersion, motivating the use of robust covariance estimation.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:univariate}{{1.3}{5}{Distribution of key variables in the analytical panel. The monetary proxies (broad money, interest rates) and macro controls exhibit right-skewness and substantial dispersion, motivating the use of robust covariance estimation}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces Broad money growth vs.\ FDI net inflows by country-year. The unconditional relationship is flat, consistent with the weak FE-DK coefficients in the main regression table.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:bivariate-bm-fdi}{{1.4}{6}{Broad money growth vs.\ FDI net inflows by country-year. The unconditional relationship is flat, consistent with the weak FE-DK coefficients in the main regression table}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces Deposit interest rate vs.\ FDI net inflows. A slight negative slope is visible in the raw data, but the association is overwhelmed by between-country heterogeneity once country fixed effects are included.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:bivariate-dep-fdi}{{1.5}{6}{Deposit interest rate vs.\ FDI net inflows. A slight negative slope is visible in the raw data, but the association is overwhelmed by between-country heterogeneity once country fixed effects are included}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces Trade openness vs.\ FDI net inflows. The strong positive unconditional correlation ($r=0.78$) is driven largely by Singapore; the within-country signal is weaker, consistent with the imprecise trade coefficients in the FE-DK regressions.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:bivariate-trade-fdi}{{1.6}{7}{Trade openness vs.\ FDI net inflows. The strong positive unconditional correlation ($r=0.78$) is driven largely by Singapore; the within-country signal is weaker, consistent with the imprecise trade coefficients in the FE-DK regressions}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces Pearson correlation matrix of main analysis variables. FDI is positively correlated with trade openness (0.78) and GDP per capita, and negatively correlated with deposit ($-0.37$), real ($-0.10$), and lending ($-0.22$) interest rates. Broad money growth correlates positively with inflation (0.32) and negatively with the human capital index ($-0.67$).}}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:correlation-heatmap}{{1.7}{8}{Pearson correlation matrix of main analysis variables. FDI is positively correlated with trade openness (0.78) and GDP per capita, and negatively correlated with deposit ($-0.37$), real ($-0.10$), and lending ($-0.22$) interest rates. Broad money growth correlates positively with inflation (0.32) and negatively with the human capital index ($-0.67$)}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.8}{\ignorespaces Missing data rates by variable. Interest-rate proxies have the highest missingness (19--27\%), concentrated in Cambodia, Lao PDR, and Timor-Leste. FDI and GDP per capita are fully observed. Controls have 0--9\% missingness.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:missingness}{{1.8}{9}{Missing data rates by variable. Interest-rate proxies have the highest missingness (19--27\%), concentrated in Cambodia, Lao PDR, and Timor-Leste. FDI and GDP per capita are fully observed. Controls have 0--9\% missingness}{figure.caption.13}{}}
